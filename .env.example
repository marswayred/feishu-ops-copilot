# demo 是明确标识的虚构数据（内置多视角切换与示例确认任务）；真实接入必须设为 feishu
APP_MODE=demo
PORT=3000
# 默认仅监听回环地址；容器部署按网络隔离要求设为 0.0.0.0
HOST=127.0.0.1
# npm run dev 时的浏览器地址；部署时设为实际 HTTPS 域名，不含路径或末尾斜杠
# 飞书开放平台需同步配置安全域名及网页授权重定向 URL: ${APP_ORIGIN}/api/auth/oauth/callback
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# 以下仅供服务端使用；不要放入任何 VITE_ 前缀变量
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选历史字段，已不再做企业编号校验；可留空
FEISHU_TENANT_KEY=

# 可选：全局允许登录本应用的 open_id 白名单（留空表示所有可授权本应用的企业员工均可登录确认已读）
ALLOWED_OPEN_IDS=
# 运营管理员权限配置：指定可进入「邮箱提取」与「分发确认管理」后台的 open_id 或员工工号（英文逗号分隔）
# 普通员工无需在此列出即可通过邮件链接完成本人实名已读确认；若留空也可在首次登录后于页面内绑定管理员
ADMIN_OPEN_IDS=
ADMIN_EMPLOYEE_NOS=

# 仅当位于一个可信的反向代理之后时设置 1；勿随意启用
TRUST_PROXY=0

# 本地持久化与通讯录缓存配置
DB_PATH=data/ops-helper.sqlite
DIRECTORY_CACHE_TTL_HOURS=168
DIRECTORY_CACHE_PATH=data/directory-cache.json
