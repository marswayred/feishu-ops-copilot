# demo 是明确标识的虚构数据；真实接入必须设为 feishu
APP_MODE=demo
PORT=3000
# 默认仅监听回环地址；容器部署按网络隔离要求设为 0.0.0.0
HOST=127.0.0.1
# npm run dev 时的浏览器地址；部署时设为实际 HTTPS 域名，不含路径或末尾斜杠
APP_ORIGIN=http://localhost:5173
NODE_ENV=development

# 以下仅供服务端使用；不要放入任何 VITE_ 前缀变量
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选历史字段，已不再做企业编号校验；可留空
FEISHU_TENANT_KEY=
# 可选：进一步限制可使用本工具的 open_id，英文逗号分隔；空值表示能授权本应用的用户
ALLOWED_OPEN_IDS=
# 仅当位于一个可信的反向代理之后时设置 1；勿随意启用
TRUST_PROXY=0
# 通讯录本地缓存：默认写入 data/directory-cache.json，有效期 168 小时（7 天）
DIRECTORY_CACHE_TTL_HOURS=168
DIRECTORY_CACHE_PATH=data/directory-cache.json
